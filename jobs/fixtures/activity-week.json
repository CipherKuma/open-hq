 "messages": [
  {
   "id": "msg_001",
   "channelId": "dm:support",
   "author": "you",
   "text": "That reply to Marta was too long and too apologetic. Three sentences max.",
   "createdAt": "2026-10-20T19:20:00+08:00"
  },
  {
   "id": "msg_002",
   "channelId": "dm:revenue",
   "author": "you",
   "text": "Refunds under $15: just tell me, don't make me approve each one twice.",
   "createdAt": "2026-10-20T19:22:00+08:00"
  },
  {
   "id": "msg_003",
   "channelId": "dm:ship",
   "author": "you",
   "text": "Good call on the revert. For deploys in the evening, tell me before touching anything.",
   "createdAt": "2026-10-20T19:25:00+08:00"
  },
  {
   "id": "msg_004",
   "channelId": "dm:cos",
   "author": "you",
   "text": "Lead the handover with whatever blocks revenue. Everything else goes below.",
   "createdAt": "2026-10-21T19:12:00+08:00"
  },
  {
   "id": "msg_005",
   "channelId": "dm:support",
   "author": "you",
   "text": "Never promise a ship date in a customer email. Say we are looking into it.",
   "createdAt": "2026-10-21T19:14:00+08:00"
  },
  {
   "id": "msg_006",
   "channelId": "dm:scout",
   "author": "you",
   "text": "Competitor pricing changes matter more than Reddit threads. Rank them first.",
   "createdAt": "2026-10-22T19:08:00+08:00"
  },
  {
   "id": "msg_007",
   "channelId": "group:launch",
   "author": "you",
   "text": "Quillbill customers are translators, they hate jargon. Plain words in replies.",
   "createdAt": "2026-10-22T19:15:00+08:00"
  },
  {
   "id": "msg_008",
   "channelId": "dm:ship",
   "author": "you",
   "text": "Don't propose rollbacks for single-browser bugs, open an issue and a fix PR instead.",
   "createdAt": "2026-10-23T19:10:00+08:00"
  },
  {
   "id": "msg_009",
   "channelId": "dm:revenue",
   "author": "you",
   "text": "Annual plan refunds after 30 days always come to me, don't draft them.",
   "createdAt": "2026-10-23T19:18:00+08:00"
  },
  {
   "id": "msg_010",
   "channelId": "dm:cos",
   "author": "you",
   "text": "Handover is too long on weekdays. 4 items max, Sunday can be longer.",
   "createdAt": "2026-10-24T19:30:00+08:00"
  },
  {
   "id": "msg_011",
   "channelId": "dm:support",
   "author": "you",
   "text": "Spam you filed was fine. Do not reply to spam even to unsubscribe.",
   "createdAt": "2026-10-24T19:33:00+08:00"
  },
  {
   "id": "msg_012",
   "channelId": "dm:scout",
   "author": "you",
   "text": "Weekly growth recap was good. Keep the numbers vs last week format.",
   "createdAt": "2026-10-25T10:20:00+08:00"
  },
  {
   "id": "msg_013",
   "channelId": "backroom:t1",
   "author": "support",
   "text": "@ship customer sees empty submissions in Safari, any recent deploy?",
   "createdAt": "2026-10-21T09:41:00+08:00"
  },
  {
